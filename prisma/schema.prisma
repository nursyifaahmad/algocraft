// Prisma Schema for AlgoCraft (Development / SQLite)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  name      String    @default("Guru Informatika")
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id        String    @id @default(cuid())
  code      String    @unique
  title     String
  className String    @default("X-5")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id])
  students  Student[]
}

model Student {
  id           String         @id @default(cuid())
  sessionId    String
  session      Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name         String
  absentNo     Int
  avatar       String         @default("avatar-1")
  hearts       Int            @default(3)
  coins        Int            @default(100)
  xp           Int            @default(0)
  currentLevel Int            @default(1)
  activeTab    Int            @default(1)
  lastActiveAt DateTime       @default(now())
  isFinished   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  scores       Score[]
  badges       StudentBadge[]

  @@unique([sessionId, absentNo])
}

model Score {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  missionType    String   // TP1_IPO, TP2_ALGO, TP3_BRANCH, TP4_FLOWCHART, TP5_PSEUDO, TP6_DEBUG
  percentage     Float    // 0 - 100
  rubricScore    Int      // 1 - 4
  attempts       Int      @default(1)
  timeSpent      Int      @default(0)
  submissionData String?  // JSON detail jawaban
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, missionType])
}

model StudentBadge {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeCode  String
  title      String
  icon       String
  unlockedAt DateTime @default(now())

  @@unique([studentId, badgeCode])
}
